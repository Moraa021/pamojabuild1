{
  "name": "volunteer-tasks-frontend",
  "version": "1.0.0",
  "description": "Frontend for the PamojaBuild Bitcoin Lightning platform",
  "type": "module",
  "scripts": {
    "dev":          "vite",
    "build":        "vite build",
    "preview":      "vite preview",
    "test":         "vitest run",
    "test:watch":   "vitest",
    "test:ui":      "vitest --ui",
    "test:e2e":     "playwright test",
    "test:e2e:ui":  "playwright test --ui",
    "lint":         "eslint js/**/*.js",
    "format":       "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test":      "^1.44.0",
    "@vitest/ui":            "^1.6.0",
    "eslint":                "^9.3.0",
    "prettier":              "^3.2.5",
    "vite":                  "^5.2.11",
    "vitest":                "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
