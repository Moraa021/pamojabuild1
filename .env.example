# HTTP server
SERVER_PORT=8080

# PostgreSQL
DATABASE_URL=postgres://localhost:5432/pamoja?sslmode=disable
TEST_DATABASE_URL=postgres://localhost:5432/pamoja_test?sslmode=disable

# Browser sessions and CORS
# Local HTTP development requires false. Production must use true with HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_NAME=pamojabuild_session
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Lightning node
LND_CLIENT_MODE=grpc
LND_HOST=localhost:10009
LND_REST_HOST=https://localhost:8080
LND_MACAROON=/path/to/admin.macaroon
LND_MACAROON_HEX=
LND_TLS_PATH=/path/to/tls.cert

# Ledger integrity
# Replace this with a long, cryptographically random production secret.
SERVER_SECRET=replace-with-a-random-ledger-secret
